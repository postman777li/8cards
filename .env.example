# Copy this file to .env only for local experiments. Never commit .env.
# Production secrets belong in the hosting platform's secret manager.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Production only: full public HTTPS origin, with no trailing slash.
# Example: https://your-service.onrender.com
PUBLIC_BASE_URL=

# Comma-separated exact HTTP(S) origins allowed to open /ws.
# Production should normally match PUBLIC_BASE_URL.
TRUSTED_ORIGINS=

# Production PostgreSQL connection URL. SECRET: never paste into chat, logs,
# screenshots, source control, or PUBLIC_BASE_URL/TRUSTED_ORIGINS.
DATABASE_URL=
# The production URL must enable TLS, normally with sslmode=require.

# Local SQLite path. Do not set together with DATABASE_URL.
EIGHTCARDS_DB=data/8cards.sqlite

# Optional operational settings.
STATIC_DIR=apps/web/dist
EIGHTCARDS_MIGRATIONS_DIR=apps/server/migrations
SHUTDOWN_TIMEOUT_MS=25000
