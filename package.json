{
  "name": "8cards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "永城八张在线版 TypeScript 单仓库",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @8cards/web --filter @8cards/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  }
}
